// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  userId         Int             @id @default(autoincrement())
  username       String          @unique
  email          String          @unique
  hashPassword   String
  startFund      Float?
  // yourModel      String?
  addFund        Float?
  journalRecords JournalRecord[]
  entryModels    EntryModel[]
  fundHistory    FundHistory[]
}

model FundHistory {
  fundId     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  amouth Float?
  User       User? @relation(fields: [userId], references: [userId])
  userId Int?
}

model EntryModel {
  modelId       Int             @id @default(autoincrement())
  modelName     String
  userId   Int
  user     User            @relation(fields: [userId], references: [userId])
  journals JournalRecord[]

  @@unique([modelName, userId])
}

// use entryId as a model represent
// @@unique([name, userId]) --> Prevent Duplicates eg. userId = 1, name = "ICT FVG" and userId = 1, name = "ICT FVG" --> X

model Asset {
  assetId        Int             @id @default(autoincrement())
  assetName      String          @unique
  journalRecords JournalRecord[]
}
// Add leverage
model JournalRecord {
  recordId       Int          @id @default(autoincrement())
  userId         Int
  entryAssetId        Int
  entryAssetName     String
  entryModelId   Int
  entryModelName String
  user           User         @relation(fields: [userId], references: [userId])
  asset          Asset        @relation(fields: [entryAssetId], references: [assetId])
  entryModel     EntryModel   @relation(fields: [entryModelId], references: [modelId])
  setUpTier      SetUpTier
  entryDateTime  DateTime?    @default(now())
  exitDateTime   DateTime?
  entryPrice     Float
  SL             Float
  TP             Float
  advantage      String?
  disadvantage   String?
  notes          String?
  feedback       String?
  imageUrl       String?
  winLose        WinLoseType?
  currentBalance Float?
  duration       Int?
  margin         Float
  positionPnL    Float @default(0)
  riskPerTrade   Float
  side           PositionSide
  leverage       Int
}
// if win = margin * leverage * TP
// if lose = margin * leverage * SL
// if open = pass

enum PositionSide {
  LONG
  SHORT
}

enum SetUpTier {
  A
  B
  C
  D
  E
  F
}

enum WinLoseType {
  WIN
  LOSE
  OPEN
}
